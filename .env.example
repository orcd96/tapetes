# ───── Django ─────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# ───── Base de datos ─────
DB_NAME=tapetes
DB_USER=tapetes_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# ───── Redis / Celery ─────
REDIS_URL=redis://localhost:6379/0

# ───── WhatsApp (GoHighLevel webhook, opcional) ─────
GHL_WEBHOOK_URL=https://hooks.gohighlevel.com/...

# ───── Seguridad (producción) ─────
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
CORS_ALLOWED_ORIGINS=https://tudominio.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ───── DigitalOcean Spaces (fotos de tapetes) ─────
USE_SPACES=False
SPACES_KEY=your-spaces-access-key
SPACES_SECRET=your-spaces-secret-key
SPACES_BUCKET=rugspa-media
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
